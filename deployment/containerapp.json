{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "0.1.5",
  "parameters": {
    "dockerioPassword": {
      "type": "secureString",
      "metadata": {
        "description": "Docker Hub personal access token for pulling images. Pass at deploy time with --parameters; never commit the value."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "potagainsthumanity",
      "location": "northcentralus",
      "properties": {
        "environmentId": "/subscriptions/bd796e72-a429-47a2-b9bc-7000b4162718/resourceGroups/PoT/providers/Microsoft.App/managedEnvironments/pot-env",
        "configuration": {
          "maxInactiveRevisions": 1,
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "customDomains": [
              {
                "bindingType": "SniEnabled",
                "certificateId": "/subscriptions/bd796e72-a429-47a2-b9bc-7000b4162718/resourceGroups/PoT/providers/Microsoft.App/managedEnvironments/pot-env/managedCertificates/pot.webswerve.com-pot-env-260204211626",
                "name": "pot.webswerve.com"
              }
            ],
            "traffic": [
              {
                "weight": 100,
                "latestRevision": true
              }
            ]
          },
          "registries": [
            {
              "server": "docker.io",
              "username": "whiplashpntz",
              "passwordSecretRef": "dockerio-password"
            }
          ],
          "secrets": [
            {
              "name": "dockerio-password",
              "value": "[parameters('dockerioPassword')]"
            }
          ]
        },
        "template": {
          "revisionSuffix": "v0-1-5",
          "containers": [
            {
              "name": "server",
              "image": "whiplashpntz/potagainsthumanity:server-0.1.5",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ]
            },
            {
              "name": "client",
              "image": "whiplashpntz/potagainsthumanity:client-0.1.5",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "UPSTREAM_HOST",
                  "value": "localhost:8081"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1,
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}